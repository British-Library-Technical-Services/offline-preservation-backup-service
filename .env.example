# Offline Preservation Backup Service - Sample Environment Configuration
# Copy this file to .env and adjust the paths for your environment.
# Both paths must be absolute.

# Absolute path to the source directory tree you wish to back up.
SOURCE_LOCATION="/absolute/path/to/source"

# Absolute path to the destination (backup) directory tree.
# Must exist and be writable. Logs (backup.log) and reports are written here.
BACKUP_LOCATION="/absolute/path/to/backup"

# (Optional) Override Python path or other runtime settings here.
# PYTHONPATH="${PYTHONPATH}:./"

# After editing, export variables (if not using a loader) or use a tool like:
#   pip install python-dotenv
# and load them programmatically if desired.
